@model BgInvoiceForPrintChooseModel

@{
    ViewBag.Title = "Choose Invoice number";
}

<form class="get">
<div class="row">      
        <div class="row col-md-4 mb-3">
            <label asp-for="MyCompanyId">Seller</label>
            <select name= "MyCompanyId" asp-for="MyCompanyId" class="form-control">
            <option value="">All</option>
                @foreach (var myCompany in Model.MyCompanies)
                {
                       <option value="@myCompany.Id">@myCompany.Name</option>
                }
            </select>
        </div>
          <div class="form-group col-md-4">
            <label asp-for="BgInvoiceNumberId" class="control-label">Select BgInvoice Number</label>          
             <select class="form-control" id="BgInvoiceNumberId" name="BgInvoiceNumberId" asp-for="BgInvoiceNumberId" asp-items="@(new SelectList(string.Empty,"BgInvoiceId", "BgInvoiceNumber"))"></select>               
        </div>
 </div>
    <hr /> 
    <input type="submit" value="BG Invoice" class="btn btn-primary mt-3" 
               asp-controller="Documents" 
               asp-action="BgInvoice"
               asp-route-bgInvoiceNumberId="@Model.BgInvoiceNumberId"/> 
</form>

@section Scripts {
         <script src="/js/getBgInvoiceNumbers.js" type="text/javascript">                                       
         </script>

}